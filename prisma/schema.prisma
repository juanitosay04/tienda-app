datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id           Int           @id @default(autoincrement())
  category     String
  name         String
  price        Float
  stock        Int           @default(0)
  minStock     Int           @default(5)
  transactions Transaction[]
}

model Transaction {
  id            Int      @id @default(autoincrement())
  type          String   // "VENTA" o "COMPRA"
  paymentMethod String?  @default("EFECTIVO") // "EFECTIVO" o "TRANSFERENCIA"
  quantity      Int
  total         Float
  date          DateTime @default(now())
  productId     Int
  product   Product  @relation(fields: [productId], references: [id])
}

model CashRegisterClose {
  id             Int      @id @default(autoincrement())
  date           DateTime @default(now())
  expectedCash   Float
  actualCash     Float
  difference     Float
  totalTransfers Float
  salesCount     Int
}

model Expense {
  id            Int      @id @default(autoincrement())
  description   String
  amount        Float
  paymentMethod String   @default("EFECTIVO")
  date          DateTime @default(now())
}

model Customer {
  id           Int                @id @default(autoincrement())
  name         String
  phone        String?
  notes        String?
  createdAt    DateTime           @default(now())
  transactions FiadoTransaction[]
}

model FiadoTransaction {
  id          Int      @id @default(autoincrement())
  customerId  Int
  customer    Customer @relation(fields: [customerId], references: [id])
  type        String   // "FIADO" | "ABONO"
  amount      Float
  description String?
  date        DateTime @default(now())
}

model StoreConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  label     String?
  updatedAt DateTime @updatedAt
}


